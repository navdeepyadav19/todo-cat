# Copy to .env.local and fill in from your Supabase project
# (Dashboard → Project Settings → API). .env.local is gitignored.
#
# Both of these ship in the browser bundle and are meant to be public.
# The `service_role` key is NOT one of these and must never go in here —
# it bypasses row-level security entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
